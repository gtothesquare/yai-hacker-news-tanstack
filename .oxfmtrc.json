{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/build",
    "**/public",
    "pnpm-lock.yaml",
    "src/routeTree.gen.ts"
  ]
}
