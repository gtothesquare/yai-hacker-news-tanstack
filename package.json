{
  "name": "yai-hacker-news-tanstack",
  "version": "1.0.0",
  "description": "yet another anther hacker news clone, this time tan stack",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:infra": "docker compose up -d",
    "dev:infra:stop": "docker compose down",
    "dev:infra:reset": "docker compose down -v && docker compose up -d",
    "dev:infra:logs": "docker compose logs -f"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.50",
    "autoprefixer": "10.5.5",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "inngest": "4.20.0",
    "nitro": "3.0.260903-beta",
    "postcss": "8.5.28",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "timeago.js": "4.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsc-files": "1.1.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{ts,tsx}": "tsc-files --noEmit",
    "*.{json,css,md,yaml,yml}": [
      "oxfmt --write"
    ]
  }
}
