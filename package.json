{
  "name": "yai-hacker-news-tanstack",
  "version": "1.0.0",
  "description": "yet another anther hacker news clone, this time tan stack",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:infra": "docker compose up -d",
    "dev:infra:stop": "docker compose down",
    "dev:infra:reset": "docker compose down -v && docker compose up -d",
    "dev:infra:logs": "docker compose logs -f"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "autoprefixer": "10.6.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "inngest": "4.26.0",
    "nitro": "3.0.260903-beta",
    "postcss": "8.5.31",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "timeago.js": "4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsc-files": "1.1.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{ts,tsx}": "tsc-files --noEmit",
    "*.{json,css,md,yaml,yml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
